# Copy to .env (never commit .env). Generate two independent random secrets of at least 32 characters.
PROFILE=dev
POSTGRES_DB=reservation_info
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change-me
SECRET_KEY=
OTP_SECRET=
REDIS_HOST=localhost
REDIS_PORT=6379
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=hotelflow@localhost
# Use true only once on a backed-up legacy database after following README.
FLYWAY_BASELINE_ON_MIGRATE=false
